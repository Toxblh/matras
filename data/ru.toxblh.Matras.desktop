[Desktop Entry]
Type=Application
Name=Matras
GenericName=Team Chat
Comment=Chat, threads and calls on a Mattermost server
Exec=matras %u
Icon=ru.toxblh.Matras
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=Matras;Mattermost;chat;team;messaging;
# The SSO callback scheme. `mattermost-dev` rather than `mattermost`,
# which belongs to the official desktop app; the server picks it when the
# desktop token starts with "dev-".
MimeType=x-scheme-handler/mattermost-dev;
StartupNotify=true
X-GNOME-UsesNotifications=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=matras --new-window
